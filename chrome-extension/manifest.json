{
  "manifest_version": 3,
  "name": "GetAIPhotoEditor",
  "version": "1.0.0",
  "description": "Upload photos and open GetAIPhotoEditor to remove backgrounds, retouch, and enhance images.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "GetAIPhotoEditor",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
